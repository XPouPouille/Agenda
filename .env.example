# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://user:password@db:5432/dbname

# Domaine derrière Traefik (ne pas committer de vraie valeur)
TRAEFIK_DOMAIN=

# URL(s) autorisée(s) en CORS pour le frontend, séparées par des virgules
# (généralement https://<TRAEFIK_DOMAIN>)
CORS_ORIGINS=

# URL du frontend utilisée pour rediriger après le login Google
FRONTEND_URL=

# Identifiants OAuth Google Cloud Console (type "Application Web")
# Redirect URI à déclarer dans Google Cloud Console : https://<TRAEFIK_DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
